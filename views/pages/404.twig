{% extends "base.twig" %}

{% block content %}

    <section class="404-page">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="mb-3">Oups ! Cette page est introuvable.</h1>

                    <p class="mb-3">La page que vous cherchez n'existe pas ou a été déplacée.</p>

                    <a class="btn btn-primary btn-icon-start" href="{{ get_the_permalink(config.home) }}" role="button"
                       title="Accèder à la page d'accueil">
                        {{ svg_icon('arrow_left')|raw }}
                        Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
